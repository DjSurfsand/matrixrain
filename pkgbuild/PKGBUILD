pkgname=matrixrain
pkgver=0.1.0
pkgrel=1
pkgdesc='Rains your wallpaper characters down the screen, with an on/off toggle'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'hicolor-icon-theme')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/matrixrain "$pkgdir/usr/bin/matrixrain"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/matrixrain.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/matrixrain.svg"
  install -Dm644 "$startdir/matrixrain.desktop" "$pkgdir/usr/share/applications/matrixrain.desktop"
}
